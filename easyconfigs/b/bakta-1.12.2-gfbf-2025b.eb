easyblock = 'PythonBundle'

name = 'bakta'
version = '1.12.2'

homepage = "https://github.com/oschwengers/bakta"
description = """Bakta is a tool for the rapid & standardized annotation of bacterial genomes and plasmids
 from both isolates and MAGs. It provides dbxref-rich, sORF-including and taxon-independent annotations
 in machine-readable JSON & bioinformatics standard file formats for automated downstream analysis."""

toolchain = {'name': 'gfbf', 'version': '2025b'}

builddependencies = [
    ('scikit-build-core', '0.11.5'),  # pyrodigal
    ('Cython', '3.1.2'),              # pyrodigal
]

dependencies = [
    ('Python', '3.13.5'),
    ('SciPy-bundle', '2025.07'),  # numpy, pandas, python-dateutil, pyparsing, requests (via Python-bundle-PyPI)
    ('Biopython', '1.86'),
    ('PyYAML', '6.0.2'),
    ('PyHMMER', '0.12.3','',('gompi','2025b')),        # bakta 1.12.2 requires pyhmmer >= 0.12.0
    ('python-isal', '1.9.1'),
    ('zlib-ng', '2.2.5'),         # C library; the Python zlib-ng extension below links against it
    ('archspec', '0.2.7'),
]

exts_list = [
    # --- alive-progress (3.3.0 pins about-time==4.2.1 and replaces grapheme with graphemeu) ---
    ('about_time', '4.2.1', {
        'source_tmpl': SOURCE_PY3_WHL,
        'checksums': ['8bbf4c75fe13cbd3d72f49a03b02c5c7dca32169b6d49117c257e7eb3eaee341'],
