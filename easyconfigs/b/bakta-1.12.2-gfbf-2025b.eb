        'checksums': ['63dd33bb94cde15ad9e5b666dbba8fedf71b72a4935d6fb9a92931e69402c9ff'],
    }),
    # --- matplotlib stack (compiled components installed from manylinux wheels) ---
    ('cycler', '0.12.1', {
        'checksums': ['88bb128f02ba341da8ef447245a9e138fae777f6a23943da4540077d3601eb1c'],
    }),
    ('kiwisolver', '1.5.1', {
        'source_tmpl': '%(name)s-%(version)s-cp313-cp313-manylinux2014_x86_64.manylinux_2_17_x86_64.whl',
        'checksums': ['74ad5c3dad54a4641b4c28cd15ded70899d04459c6c7aeacafea716be97cce6d'],
    }),
    ('contourpy', '1.4.0', {
        'source_tmpl': '%(name)s-%(version)s-cp313-cp313-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl',
        'checksums': ['f1219a8898523cba821085f2da8a1b962cc696325763f09d7f93538ba43b2d70'],
    }),
    ('fonttools', '4.69.1', {
        'modulename': 'fontTools',
        'source_tmpl': SOURCE_PY3_WHL,
        'checksums': ['20e9dfac71694d9eeae48bb53c877bdf43b914794d69a769940728a1929cc835'],
    }),
    ('pillow', '13.0.0', {
        'modulename': 'PIL',
        'source_tmpl': '%(name)s-%(version)s-cp313-cp313-manylinux_2_27_x86_64.manylinux_2_28_x86_64.whl',
