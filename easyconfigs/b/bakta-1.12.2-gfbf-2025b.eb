local_bins = ['bakta', 'bakta_db', 'bakta_io', 'bakta_plot', 'bakta_proteins']

modextravars = {
                 'BAKTA_DB':':/gpfs3/well/kir/projects/mirror/bakta/db-nov26-2026',            
               }


sanity_check_paths = {
    'files': ['bin/%s' % bin for bin in local_bins],
    'dirs': ['lib/python%(pyshortver)s/site-packages'],
}

sanity_check_commands = ['%s --help' % bin for bin in local_bins] + [
    """python -c 'import matplotlib; matplotlib.use("Agg"); import matplotlib.pyplot' """,
]

# non-interactive plotting backend, as the bundled matplotlib has no Tk support
modextravars = {'MPLBACKEND': 'Agg'}

moduleclass = 'tools'
