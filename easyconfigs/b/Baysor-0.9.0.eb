easyblock = 'Tarball'

name = 'Baysor'
version = '0.9.0'

homepage = 'https://github.com/kharchenkolab/Baysor'
description = "Baysor is a tool for performing cell segmentation on imaging-based spatial transcriptomics data. It optimizes segmentation considering the likelihood of transcriptional composition, size and shape of the cell."

toolchain = SYSTEM

source_urls = ['https://github.com/kharchenkolab/Baysor/releases/download/cpp-%(version)s']
sources = ['%(namelower)s-%(version)s-linux-x86_64.tar.gz']
checksums = ['6848f2b924a20a32b19db568e286b156649f0a7ebc8c7ab54d1900f74f9b0e8a']

#postinstallcmds = ['mv %(installdir)s/bin %(installdir)s']

# sanity checks

sanity_check_paths = {
     'files': ['bin/%(namelower)s'],
     'dirs': ['bin'], }

sanity_check_commands = ['%(namelower)s --help']

modextrapaths = {'PATH': ''}

moduleclass = 'bio'

